{
  "name": "@sector-labs/wdio-junit-reporter",
  "version": "10.0.0",
  "description": "A WebdriverIO reporter that creates Jenkins compatible XML based JUnit reports",
  "author": "Sector Labs <open-source@sectorlabs.ro> / Christian Bromann",
  "homepage": "https://github.com/SectorLabs/wdio-junit-reporter",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SectorLabs/wdio-junit-reporter.git"
  },
  "keywords": [
    "webdriver",
    "wdio",
    "wdio-reporter",
    "junit",
    "reporter"
  ],
  "bugs": {
    "url": "https://github.com/SectorLabs/wdio-junit-reporter/issues"
  },
  "scripts": {
    "verify": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf build",
    "prepare": "tsc"
  },
  "dependencies": {
    "@wdio/reporter": "^9.26.1",
    "@wdio/types": "^9.26.1",
    "json-stringify-safe": "^5.0.1",
    "junit-report-builder": "^5.1.1"
  },
  "devDependencies": {
    "@types/json-stringify-safe": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
